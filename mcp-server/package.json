{
  "name": "retail-metrics-mcp",
  "version": "1.0.0",
  "description": "MCP server over the Acme retail semantic layer: list, explain and query governed metrics, plus allow-listed read-only SQL on DuckDB.",
  "license": "MIT",
  "author": "Samiul Huda",
  "type": "module",
  "private": true,
  "bin": { "retail-metrics-mcp": "dist/src/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec dist/test/server.test.js",
    "start": "node dist/src/index.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
